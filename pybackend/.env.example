# Legacy Pulse V2 — copy to .env and set strong values.
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./legacy_pulse.db

# REQUIRED — min 32 chars
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# REQUIRED — exactly 64 hex chars (32 bytes). NEVER change after data is written.
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173
