# Legacy Pulse Environment Configuration
# Copy to .env and fill in values. NEVER commit real .env.

APP_ENV=development
DEBUG=true

# SQLite for local; use postgresql://... for production
DATABASE_URL=sqlite:///./legacy_pulse.db

# Generate strong secrets:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# 32-byte hex keys for AES-256-GCM
# python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FILE_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Comma-separated origins for production
# CORS_ORIGINS=["http://localhost:5173"]
