# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is already listed in .gitignore.

# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Origin the frontend is served from; used for CORS. In this MVP the
# frontend is served by the same Express app, so this normally matches PORT.
CLIENT_ORIGIN=http://localhost:4000

# ---- Auth secrets ----
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Encryption ----
# Must be a base64-encoded 32-byte (256-bit) key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# ---- Password hashing ----
BCRYPT_COST=12

# ---- Storage ----
# Absolute or relative paths are both fine; defaults shown.
DB_PATH=./data/legacy_pulse.db
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15

# ---- Business rules ----
REQUIRED_RELEASE_CONFIRMATIONS=2

# ---- Rate limiting (optional override) ----
# AUTH_RATE_LIMIT_MAX=10

# ---- Seed script safety (V2.0-B) ----
# npm run seed refuses to run when NODE_ENV=production, since it creates
# publicly-documented demo credentials. Only set this to true if you
# genuinely intend to seed a production-configured database (e.g. a
# disposable staging environment that reuses prod-like config).
# ALLOW_PROD_SEED=true

# ---- Account lockout (V2.0-C) ----
# ACCOUNT_LOCKOUT_THRESHOLD=5
# ACCOUNT_LOCKOUT_MINUTES=15

# ---- Trust proxy (V2.0-C) ----
# Leave as 'false' unless this app is deployed behind a reverse proxy/load
# balancer YOU control. If so, set to the number of proxy hops to trust
# (e.g. '1') or a specific proxy IP/CIDR — see Express's `trust proxy` docs.
# Blindly trusting X-Forwarded-For without a real proxy in front lets a
# client spoof its own IP for rate-limiting and audit-log purposes.
# TRUST_PROXY=false
